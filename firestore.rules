rules_version = '2';

// Invite-only, and strictly per-user.
//
// * Only accounts listed in /allowed/{email} (plus the owner) can read or write
//   anything at all.
// * Each of those accounts can only reach documents under its own users/{uid}.
//   Nobody using the app can see anyone else's hours.
// * The owner administers the list. Note that the owner, like anyone with
//   access to the Firebase console, can read every document in the project:
//   rules constrain the app, not the project's owner.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Kept in step with VITE_OWNER_EMAIL in .env.
    function isOwner() {
      return signedIn() && email() == 'iliasparaskevas3@gmail.com';
    }

    function invited() {
      return signedIn() && exists(/databases/$(database)/documents/allowed/$(email()));
    }

    // The guest list. A person may check their own entry; only the owner sees
    // or changes the whole list.
    match /allowed/{personEmail} {
      allow get: if isOwner() || (signedIn() && email() == personEmail);
      allow list, write: if isOwner();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid && (invited() || isOwner());
    }
  }
}
